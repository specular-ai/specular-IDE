{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": { "@specular/plugin-api": ["./packages/plugin-api/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/probe-codex.mts", "playwright.config.ts"]
}
