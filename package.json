{
  "name": "specular",
  "version": "0.1.0",
  "private": true,
  "description": "A Markdown-centered desktop IDE for agentic development",
  "productName": "Specular",
  "main": "dist/main.cjs",
  "author": "Specular contributors",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "npm run build && playwright test",
    "test:package": "node scripts/smoke-package.mjs",
    "package": "electron-forge package",
    "check": "npm run typecheck && npm test && npm run build",
    "sdk:pack": "node scripts/build-plugin-sdk.mjs",
    "test:sdk": "npm run sdk:pack && node scripts/test-plugin-sdk.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@electron-forge/cli": "7.11.2",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.63.0",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.15",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "extract-zip": "2.0.1",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  }
}
